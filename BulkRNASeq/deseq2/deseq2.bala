[research]
description=A wrapper function for deseq2 for two groups only
name=deseq2

[run]
command=docker run --rm
script= bash /home/start.sh
image= ghcr.io/reproduciblebioinformatics/docker4seq-deseq2-v2:latest
usage= <outDir> <matrix_path> <matrix_sep> <metadata> <metadata_sep> <log2fc> <fdr> <ref_covar> <target_covar> <threads> <quiet>

[directory]
name=workDir
description=indicating the working folder
flag=io
mount=/workDir

[directory]
name=outDir
description=indicating the folder where results will be written
mount=/results
flag=out

[file]
name=matrix_path
flag=cp
description = Path to the input expression matrix file (samples in columns, features/genes in rows)

[parameter]
name=matrix_sep
values=',',';','\t','tab'
description = File separator (use "," or ";" for CSV, "\t" ora "tab" for TSV) for matrix file

[file]
name=metadata
flag=cp
description = A CSV or TSV file containing metadata for files in the input director

[parameter]
name=metadata_sep
values=',',';','\t','tab'
description = File separator (use "," or ";" for CSV, "\t" ora "tab" for TSV) for metadata file

[parameter]
name = log2fc
description = Log2 Fold Change absolute threshold for filtering differentially expressed genes (e.g., 1.0 for a 2-fold change)

[parameter]
name = fdr
description = False Discovery Rate threshold (adjusted p-value / padj) used to control for multiple testing significance (e.g., 0.05).

[parameter]
name = ref_covar
description = The reference or baseline level of the primary condition variable (e.g., control, untreated, wildtype), used as the denominator in the differential expression contrast matrix.

[parameter]
name = target_covar
description = The target or experimental level of the primary condition variable (e.g., treated, knockout, mutant), evaluated against the reference baseline to calculate fold change values.

[parameter]
name = threads
description = a number indicating the number of cores to be used from the application

[parameter]
name = quiet
values = false,true
description = Set to "true" to suppress tool processing messages, set to "false" to keep verbose logging enabled.