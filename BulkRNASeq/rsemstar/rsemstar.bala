[research]
description=This function executes the docker container rsemstar to calculate gene/isoforms counts using RSEM with STAR as mapper 
name=rsemstar

[run]
command=docker run --rm
script= bash /home/start.sh
image= ghcr.io/reproduciblebioinformatics/docker4seq-rsemstar-v2:latest
usage= <inputDir> <genomeDir> <outDir> <metadata> <metadata_sep> <strandness> <save_bam> <seq_type> <threads> <quiet> 

[directory]
name=workDir
description=indicating the working folder
flag=io
mount=/workDir

[directory]
name=inputDir
description=indicating where gzip fastq trimmed files are located
flag=in
mount=/data_fastq

[directory]
name=genomeDir
description=indicating the folder where the indexed reference genome for STAR/RSEM is located. IMPORTANT only genomic indexes made using ensembl genome and the corresponding gtf are supported
flag=in
mount=/genome

[directory]
name=outDir
description=indicating the folder where results will be written
mount=/results
flag=out

[file]
name=metadata
flag=cp
description = A CSV or TSV file containing metadata for files in the input director

[parameter]
name=metadata_sep
values=',',';','\t','tab'
description = File separator (use "," or ";" for CSV, "\t" ora "tab" for TSV)

[parameter]
name = strandness
description = type of sequencing protocol used for the analysis. Three options: "none" for non strand selection, "forward" for Illumina strandness protocols, "reverse" for ACCESS Illumina protocol
values = "none","forward","reverse"

[parameter]
name = save_bam
description = boolean indicating whether the genome and transcriptome bam files should be kept in outDir
values = "true","false"

[parameter]
name = seq_type
description = type of reads to be processed. Two options: "se" or "pe" respectively for single end and pair end sequencing.
values = "pe","se"

[parameter]
name = threads
value = 10
description = a number indicating the number of cores to be used from the application

[parameter]
name = quiet
values = false,true
description = Set to "true" to suppress tool processing messages, set to "false" to keep verbose logging enabled.