[research]
description=This function executes the docker container skewer1 to remove sequencing adapters from RNAseq reads
name=skewer
#
[run]
command=docker run --rm 
script= bash /home/start.sh  		
image= docker4seq-skewer-v2  
usage= <inputDir> <outDir> <adapter5> <adapter3> <seq_type> <metadata> <metadata_sep> <threads> <quiet>
#
[directory]
name=workDir
description=indicating the working folder
flag=io
mount=/workDir
#
[directory]
name=inputDir
description=indicating where gzip fastq files are located
flag=in
mount=/data_fastq
#
[directory]
name=outDir
description=indicating the folder where results will be written
mount=/results
flag=out

[parameter]
name=adapter5
description=character string indicating the fwd adapter
value="AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"

[parameter]
name=adapter3
description=character string indicating the rev adapter
value="AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"

[parameter]
name = seq_type
description = type of reads to be trimmed. Two options: "se" or "pe" respectively for single end and pair end sequencing.
values = "pe","se"

[file]
name=metadata
flag=cp
description = A CSV or TSV file containing metadata for files in the input director

[parameter]
name=metadata_sep
values=',',';','\t','tab'
description = File separator (use "," or ";" for CSV, "\t" ora "tab" for TSV)

[parameter]
name = threads
value = 10
description = a number indicating the number of cores to be used from the application

[parameter]
name = quiet
values = false,true
description = Set to "true" to suppress tool processing messages, set to "false" to keep verbose logging enabled.