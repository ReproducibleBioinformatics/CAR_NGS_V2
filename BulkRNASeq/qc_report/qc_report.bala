[research]
description=This function runs FastQC on each FASTQ file listed in the sample metadata file (matched via the SampleName column, optionally located under a SampleFolder subdirectory), then aggregates all results into a single MultiQC report. Output files are named <SampleFolder_>SampleName_fastqc.html/.zip.
name=qc_report
#
[run]
command=docker run --rm 
script= bash /home/start.sh  		
image= ghcr.io/reproduciblebioinformatics/docker4seq-qc_report-v2:latest
usage= <inputDir> <outDir> <metadata> <metadata_sep> <threads> <quiet>
#
[directory]
name=workDir
description=indicating the working folder
flag=io
mount=/workDir
#
[directory]
name=inputDir
description=indicating the folder where input data(fastq) are located
flag=in
mount=/data_fastq
[directory]

name=outDir
description=indicating the folder where results will be written
mount=/results
flag=out

[file]
name=metadata
flag=cp
description = A CSV or TSV file containing metadata for files in the input director

[parameter]
name=metadata_sep
values=',',';','\t','tab'
description = File separator (use "," or ";" for CSV, "\t" ora "tab" for TSV)

[parameter]
name = threads
value = 10
description = a number indicating the number of cores to be used from the application

[parameter]
name = quiet
value = false
description = Set to "true" to suppress tool processing messages, set to "false" to keep verbose logging enabled.