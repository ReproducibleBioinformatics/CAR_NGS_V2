[research]
description=Generate PCA graph
name=pca
#
[run]
command=docker run --rm
script= bash /home/start.sh
image= ghcr.io/reproduciblebioinformatics/docker4seq-pca-v2:latest
usage= <outDir> <matrix_path> <matrix_sep> <metadata> <metadata_sep> <pca_type> <log_transform> <remove_zero_var> <blind> <threads> <quiet>
#
[directory]
name=workDir
description=indicating the working folder
flag=io
mount=/workDir

[directory]
name=outDir
description=indicating the folder where results will be written
mount=/results
flag=out

[file]
name=matrix_path
flag=cp
description = Path to the input expression matrix file (samples in columns, features/genes in rows)

[parameter]
name=matrix_sep
values=',',';','\t','tab'
description = File separator (use "," or ";" for CSV, "\t" ora "tab" for TSV)

[file]
name=metadata
flag=cp
description = A CSV or TSV file containing metadata for files in the input director

[parameter]
name=metadata_sep
values=',',';','\t','tab'
description = File separator (use "," or ";" for CSV, "\t" ora "tab" for TSV)

[parameter]
name = pca_type
description = Specifies the normalization and transformation method to apply to the expression matrix prior to Principal Component Analysis (PCA). Must be one of "Standard" (no advanced normalization), "deseq" (blind variance-stabilizing transformation), or "deseqNormalized" (design-aware, covariate-adjusted transformation).
values = "Standard","deseq","deseqNormalized"

[parameter]
name = log_transform
description =  Applies a log_2(x + 1) transformation to the expression matrix before PCA to reduce skewness and stabilize variance. If FALSE, input values are processed as-is.
values = "true","false"

[parameter]
name = remove_zero_var
description = Filters out non-informative features (genes with zero variance across samples) prior to PCA to avoid numerical errors in prcomp. If FALSE, all features are retained.
values = "true","false"

[parameter]
name = blind
description = Whether the variance-stabilizing transformation should ignore (TRUE) or account for (FALSE) the experimental design.
values = "true","false"

[parameter]
name = threads
value = 10
description = a number indicating the number of cores to be used from the application

[parameter]
name = quiet
values = false,true
description = Set to "true" to suppress tool processing messages, set to "false" to keep verbose logging enabled.